    "format": "prettier --write . --ignore-unknown",
    "lint": "eslint .",
    "loom": "node packages/cli/dist/main.js",
    "loom:fresh": "pnpm -r build && node packages/cli/dist/main.js"
  },
  "devDependencies": {
    "@eslint/js": "^9.0.0",
    "@types/node": "^26.0.1",
    "eslint": "^9.0.0",
    "prettier": "^3.0.0",
    "typescript": "^5.0.0",
    "typescript-eslint": "^8.0.0",
    "vitest": "^4.0.0"
  }
}
