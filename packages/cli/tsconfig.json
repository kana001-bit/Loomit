{
  // IDE と typecheck 用の設定。src と test の両方を含む(rootDir を "." にして test/ も範囲に入れる)。
  // これが「tsconfig.json」なので、エディタの TS サーバがテストファイルにもこの設定を適用でき、
  // node / vitest の型が解決される。dist への出力は tsconfig.build.json が担当する(noEmit)。
  // paths を空にして @loomit/core を workspace の node_modules(dist)経由で解決するのは従来どおり。
  "extends": "../../tsconfig.base.json",
  "compilerOptions": {
    "rootDir": ".",
    "noEmit": true,
    "types": ["node", "vitest"],
    "paths": {}
  },
  "include": ["src/**/*.ts", "test/**/*.ts"],
  "exclude": ["dist"]
}
