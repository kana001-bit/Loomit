node_modules/
.pnpm-store/
dist/
coverage/
*.tsbuildinfo

# 個人のエディタ装飾(タイトルバー色など)は各自ローカルに置き、repo では追跡しない
.vscode/settings.json

# 作業メモ・設計ドラフト・タスク仕様は非公開。公開するのは docs/ 直下だけ。
# うっかり `git add .` で private ノートを追跡しないよう明示的に無視する。
docs/work/

# TypeScript build output belongs in dist/, never tracked under src/
packages/*/src/**/*.js
packages/*/src/**/*.js.map
packages/*/src/**/*.d.ts
packages/*/src/**/*.d.ts.map
